#!/usr/bin/env python3
import os
import sys
import signal
import subprocess
import argparse
import time
from pathlib import Path

HELIUM_DIR = Path.home() / ".config" / "helium"
CLI_DIR = Path(__file__).resolve().parent
PROJECT_ROOT = CLI_DIR.parent
PID_DIR = HELIUM_DIR / ".pids"
LOG_DIR = HELIUM_DIR / "logs"


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def ensure_dirs():
    PID_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)


def project_name(project):
    return project if project else "default"


def project_dir(project):
    return HELIUM_DIR / project if project else HELIUM_DIR


def pid_file(project):
    return PID_DIR / f"{project_name(project)}.pid"


def log_file(project):
    return LOG_DIR / f"{project_name(project)}.log"


def find_build_dir():
    build = PROJECT_ROOT / "build"
    if not build.exists():
        return None
    so_files = list(build.rglob("helium*.so"))
    if so_files:
        return str(build)
    return None


def resolve_pythonpath():
    env = os.environ.copy()
    pp = find_build_dir()
    if pp:
        existing = env.get("PYTHONPATH", "")
        env["PYTHONPATH"] = f"{pp}:{existing}" if existing else pp
    return env


def read_pid(pfile):
    try:
        return int(pfile.read_text().strip())
    except (ValueError, OSError):
        return None


def is_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, PermissionError):
        return False
    except OSError:
        return False


def stop_process(pfile, name):
    pid = read_pid(pfile)
    if pid is None:
        print(f"{name}: not running")
        pfile.unlink(missing_ok=True)
        return

    if not is_alive(pid):
        print(f"{name}: process already exited")
        pfile.unlink(missing_ok=True)
        return

    os.kill(pid, signal.SIGTERM)
    for _ in range(15):
        if not is_alive(pid):
            break
        time.sleep(0.2)
    else:
        os.kill(pid, signal.SIGKILL)
        time.sleep(0.1)

    pfile.unlink(missing_ok=True)
    print(f"{name}: stopped")


def cmd_init(args):
    ensure_dirs()

    pdir = project_dir(args.project)
    daemon = pdir / "daemon.py"
    if not daemon.exists():
        eprint(f"error: {daemon} not found")
        sys.exit(1)

    name = project_name(args.project)
    pfile = pid_file(args.project)
    lfile = log_file(args.project)

    pid = read_pid(pfile)
    if pid and is_alive(pid):
        eprint(f"error: {name} is already running (PID {pid})")
        sys.exit(1)
    pfile.unlink(missing_ok=True)

    env = resolve_pythonpath()
    with open(lfile, "w") as log:
        proc = subprocess.Popen(
            [sys.executable, str(daemon)],
            cwd=str(pdir),
            env=env,
            stdout=log,
            stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL,
        )

    pfile.write_text(str(proc.pid))
    print(f"{name}: started (PID {proc.pid})")


def cmd_kill(args):
    ensure_dirs()
    name = project_name(args.project)
    pfile = pid_file(args.project)
    stop_process(pfile, name)


def cmd_restart(args):
    cmd_kill(args)
    time.sleep(0.5)
    cmd_init(args)


def cmd_build(args):
    build_dir = PROJECT_ROOT / "build"
    if not build_dir.exists():
        r = subprocess.run(["meson", "setup", "build"], cwd=str(PROJECT_ROOT))
        if r.returncode != 0:
            sys.exit(r.returncode)
    else:
        r = subprocess.run(
            ["meson", "setup", "--reconfigure", "build"], cwd=str(PROJECT_ROOT)
        )
        if r.returncode != 0:
            sys.exit(r.returncode)

    r = subprocess.run(["meson", "compile", "-C", "build"], cwd=str(PROJECT_ROOT))
    sys.exit(r.returncode)


def cmd_ls(args):
    if not HELIUM_DIR.exists():
        return
    entries = sorted(
        e for e in HELIUM_DIR.iterdir()
        if e.is_dir() and not e.name.startswith(".")
    )
    if not entries:
        return
    for e in entries:
        daemon = e / "daemon.py"
        tag = " \u2713" if daemon.exists() else "  "
        pfile = pid_file(e.name)
        pid = read_pid(pfile)
        alive = pid and is_alive(pid)
        status = f" (PID {pid})" if alive else ""
        print(f" {tag} {e.name}{status}")


def cmd_status(args):
    ensure_dirs()
    found = False
    if not PID_DIR.exists():
        print("no running daemons")
        return
    for pfile in sorted(PID_DIR.glob("*.pid")):
        name = pfile.stem
        pid = read_pid(pfile)
        if pid and is_alive(pid):
            print(f"  RUNNING  {name}  (PID {pid})")
        else:
            print(f"  STOPPED  {name}")
            pfile.unlink(missing_ok=True)
        found = True
    if not found:
        print("no running daemons")


def cmd_logs(args):
    ensure_dirs()
    name = project_name(args.project)
    lfile = log_file(args.project)
    if not lfile.exists():
        eprint(f"error: no logs for {name}")
        sys.exit(1)
    try:
        subprocess.run(["tail", "-n", str(args.n), "-f", str(lfile)])
    except KeyboardInterrupt:
        pass


def cmd_install(args):
    r = subprocess.run(
        [sys.executable, "-m", "pip", "install", str(PROJECT_ROOT)],
    )
    sys.exit(r.returncode)


def cmd_run(args):
    env = resolve_pythonpath()
    r = subprocess.run(
        [sys.executable, args.file] + args.extra_args, env=env
    )
    sys.exit(r.returncode)


def main():
    parser = argparse.ArgumentParser(
        prog="helium",
        description="Helium CLI \u2014 manage desktop shell widget daemons",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "examples:\n"
            "  helium init               start the default daemon\n"
            "  helium init -p myshell    start a project daemon\n"
            "  helium kill               stop the default daemon\n"
            "  helium kill -p myshell    stop a project daemon\n"
            "  helium restart -p foo     restart a daemon\n"
            "  helium build              compile the C++ extension\n"
            "  helium ls                 list configured projects\n"
            "  helium status             show running daemons\n"
            "  helium logs               follow default daemon logs\n"
            "  helium logs -p myshell    follow project logs\n"
            "  helium run ./test.py      run a script with helium available\n"
            "  helium install            install helium via pip"
        ),
    )

    sub = parser.add_subparsers(dest="command")

    p_init = sub.add_parser("init", help="start a helium daemon")
    p_init.add_argument("-p", "--project", help="project subdirectory in ~/.config/helium")
    p_init.set_defaults(func=cmd_init)

    p_kill = sub.add_parser("kill", help="stop a running daemon")
    p_kill.add_argument("-p", "--project", help="project name")
    p_kill.set_defaults(func=cmd_kill)

    p_restart = sub.add_parser("restart", help="restart a daemon")
    p_restart.add_argument("-p", "--project", help="project name")
    p_restart.set_defaults(func=cmd_restart)

    p_build = sub.add_parser("build", help="build the C++ extension via meson")
    p_build.set_defaults(func=cmd_build)

    p_ls = sub.add_parser("ls", help="list projects in ~/.config/helium")
    p_ls.set_defaults(func=cmd_ls)

    p_status = sub.add_parser("status", help="show running daemon status")
    p_status.set_defaults(func=cmd_status)

    p_logs = sub.add_parser("logs", help="follow daemon logs")
    p_logs.add_argument("-p", "--project", help="project name")
    p_logs.add_argument("-n", type=int, default=20, help="lines to show (default 20)")
    p_logs.set_defaults(func=cmd_logs)

    p_install = sub.add_parser("install", help="install helium via pip")
    p_install.set_defaults(func=cmd_install)

    p_run = sub.add_parser("run", help="run a Python file with helium available")
    p_run.add_argument("file", help="Python file to execute")
    p_run.add_argument("extra_args", nargs=argparse.REMAINDER,
                       help="extra arguments passed to the script")
    p_run.set_defaults(func=cmd_run)

    args = parser.parse_args()
    if args.command is None:
        parser.print_help()
        sys.exit(1)

    args.func(args)


if __name__ == "__main__":
    main()
