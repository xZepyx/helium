export component WorkspaceBar {
    width: 1920px;
    height: 42px;

    in property <int> active_workspace;
    in property <string> workspace_1;
    in property <string> workspace_2;
    in property <string> workspace_3;
    in property <string> workspace_4;
    in property <string> workspace_5;

    Rectangle {
        background: #141414;

        HorizontalLayout {
            padding: 8px 12px;
            spacing: 4px;

            Rectangle {
                width: 28px; height: 26px;
                background: active_workspace == 1 ? #76b900 : #1f1f1f;
                border: 1px solid active_workspace == 1 ? #76b900 : #333;
                Text {
                    text: workspace_1;
                    color: active_workspace == 1 ? #0a0a0a : #888;
                    font-size: 11px;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                width: 28px; height: 26px;
                background: active_workspace == 2 ? #76b900 : #1f1f1f;
                border: 1px solid active_workspace == 2 ? #76b900 : #333;
                Text {
                    text: workspace_2;
                    color: active_workspace == 2 ? #0a0a0a : #888;
                    font-size: 11px;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                width: 28px; height: 26px;
                background: active_workspace == 3 ? #76b900 : #1f1f1f;
                border: 1px solid active_workspace == 3 ? #76b900 : #333;
                Text {
                    text: workspace_3;
                    color: active_workspace == 3 ? #0a0a0a : #888;
                    font-size: 11px;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                width: 28px; height: 26px;
                background: active_workspace == 4 ? #76b900 : #1f1f1f;
                border: 1px solid active_workspace == 4 ? #76b900 : #333;
                Text {
                    text: workspace_4;
                    color: active_workspace == 4 ? #0a0a0a : #888;
                    font-size: 11px;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Rectangle {
                width: 28px; height: 26px;
                background: active_workspace == 5 ? #76b900 : #1f1f1f;
                border: 1px solid active_workspace == 5 ? #76b900 : #333;
                Text {
                    text: workspace_5;
                    color: active_workspace == 5 ? #0a0a0a : #888;
                    font-size: 11px;
                    font-family: "Space Mono";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        Text {
            text: "Helium Workspaces";
            color: #555;
            font-size: 10px;
            font-family: "Space Grotesk";
            letter-spacing: 0.12em;
            text-transform: uppercase;
            vertical-alignment: center;
            horizontal-alignment: right;
            padding-right: 16px;
        }
    }
}
